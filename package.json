{
  "name": "fudma-odl-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "FUDMA ODL platform monorepo scaffold",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev --workspace @fudma/web\" \"npm run dev --workspace @fudma/api\"",
    "dev:web": "npm run dev --workspace @fudma/web",
    "dev:api": "npm run dev --workspace @fudma/api",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "npm run lint --workspace @fudma/web && npm run lint --workspace @fudma/api"
  },
  "devDependencies": {
    "concurrently": "latest",
    "prisma": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "@prisma/client": "latest"
  }
}
